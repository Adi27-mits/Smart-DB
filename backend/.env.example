# ──────────────────────────────────────────────
#  Smart Database Visualizer — Backend .env
#  Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# Server
PORT=5000

# Frontend URL (used by CORS — no trailing slash)
FRONTEND_URL=http://localhost:3000

# MySQL default connection (optional — the UI lets users supply credentials at runtime)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=
